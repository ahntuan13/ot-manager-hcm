rules_version = '2';
// Dán toàn bộ nội dung này vào: Firebase Console → Firestore Database → Rules → Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myDoc()    { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function active()   { return hasProfile() && myDoc().active == true; }
    function isAdmin()  { return active() && myDoc().role == 'admin'; }
    function isMgr()    { return active() && (myDoc().role == 'admin' || myDoc().role == 'sub'); }
    // Admin có thể cấp riêng mục "Tuyển dụng" cho 1 tài khoản (users/{uid}.pages có 'interview').
    function ivStaff()  { return isMgr() || (active() && myDoc().get('pages', []).hasAny(['interview'])); }

    // Hồ sơ người dùng (vai trò). Chỉ Admin sửa. Mỗi người đọc được hồ sơ của chính mình.
    // Ngoại lệ: email Admin gốc tự tạo hồ sơ Admin cho mình ở lần đăng nhập đầu tiên.
    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin()
        || (signedIn() && request.auth.uid == uid
            && request.auth.uid == 'MKZWSMQne1UdyjJmNdfyNQCglk23'
            && request.resource.data.role == 'admin');
      allow update, delete: if isAdmin();
    }

    // Người tự đăng ký chưa được cấp quyền → để lại yêu cầu cho Admin duyệt.
    match /pending/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow read, delete: if isAdmin();
    }

    // Dữ liệu ứng dụng: mỗi doc là 1 phần nhỏ (tháng OT, 1 dự án, 1 nhân viên...).
    match /data/{id} {
      allow read: if active();
      // Admin: ghi tất cả. Quản lý: ghi tất cả trừ file WLB.
      // Người dùng: chỉ ghi Action Plan (proj_), PU Delivery (pu_), Tiến độ dự án (prog_) và thông báo (nt_).
      allow create, update, delete: if active() && (
        isAdmin()
        || (isMgr() && id != 'wlb')
        || id.matches('(proj_|pu_|prog_|nt_).*')
      );
    }

    // ── TUYỂN DỤNG (bài thi MEP, thư mục interview/) ──
    // Ứng viên KHÔNG đăng nhập HMD: chỉ đọc được đúng tài khoản/bài làm của mình (biết tên đăng nhập), không liệt kê được.
    // Tài khoản: chỉ Quản lý/Admin tạo, sửa, xoá, liệt kê. Mật khẩu lưu băm; bản rõ (iv_cred) chỉ Quản lý đọc.
    match /iv_accounts/{u} {
      allow get: if true;
      allow list, create, update, delete: if ivStaff();
    }
    match /iv_cred/{u} {
      allow read, write: if ivStaff();
    }
    // Bài làm: ứng viên tạo/cập nhật khi chưa nộp (final=false); nộp xong (final=true) chỉ Quản lý sửa (chấm điểm).
    match /iv_subs/{u} {
      allow get: if true;
      allow list, delete: if ivStaff();
      allow create: if (ivStaff() || exists(/databases/$(database)/documents/iv_accounts/$(u)))
                    && request.resource.data.keys().hasOnly(['payload', 'final'])
                    && request.resource.data.payload is string
                    && request.resource.data.payload.size() < 600000;
      allow update: if ivStaff()
                    || (resource.data.get('final', false) != true
                        && request.resource.data.keys().hasOnly(['payload', 'final'])
                        && request.resource.data.payload is string
                        && request.resource.data.payload.size() < 600000);
    }

    // Lịch sử chỉnh sửa: ai cũng ghi được (khi đang hoạt động), chỉ Admin xem.
    match /log/{logId} {
      allow create: if active();
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
